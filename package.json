{
  "name": "viralitx-console",
  "version": "1.0.0",
  "main": "main.js",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "type-check": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/console.js",
